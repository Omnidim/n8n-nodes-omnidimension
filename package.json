{
	"name": "n8n-nodes-omnidimension",
	"version": "0.1.1",
	"description": "n8n community node for OmniDimension voice AI — dispatch calls, manage agents, and trigger workflows on completed calls",
	"keywords": [
		"n8n-community-node-package",
		"omnidimension",
		"voice-ai",
		"voice-agent",
		"phone-calls"
	],
	"license": "MIT",
	"homepage": "https://omnidim.io",
	"author": {
		"name": "OmniDimension",
		"email": "support@omnidim.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Omnidim/n8n-nodes-omnidimension.git"
	},
	"bugs": {
		"url": "https://github.com/Omnidim/n8n-nodes-omnidimension/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/OmniDimensionApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OmniDimension/OmniDimension.node.js",
			"dist/nodes/OmniDimension/OmniDimensionTrigger.node.js"
		]
	},
	"scripts": {
		"build": "tsc && mkdir -p dist/nodes/OmniDimension && cp nodes/OmniDimension/*.svg dist/nodes/OmniDimension/ && cp credentials/*.svg dist/credentials/",
		"dev": "tsc --watch",
		"lint": "eslint credentials nodes package.json",
		"test": "npm run build && node --test test/node.test.js",
		"prepublishOnly": "npm run build && npm run lint && node --test test/node.test.js"
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.29.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "9.29.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.7",
		"n8n-workflow": "^2.16.0",
		"typescript": "^5.6.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
